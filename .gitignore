# ── Virtual environment ─────────────────────────
.venv/
venv/
env/

# ── Python cache/build ───────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
build/
dist/
.eggs/

# ── Dataset (too large for git, lives on Drive/Kaggle) ──
data/
!data/.gitkeep

# ── Trained models & training runs ──────────────
models/pretrained/
models/runs/
*.pt
*.onnx
*.engine
*.torchscript

# ── Ultralytics auto-generated files ─────────────
*.cache
ultralytics_settings.json

# ── Reports (regenerated by scripts, not source) ─
reports/figures/*
reports/metrics/*
!reports/figures/.gitkeep
!reports/metrics/.gitkeep

# ── Jupyter ───────────────────────────────────────
.ipynb_checkpoints/

# ── VS Code ───────────────────────────────────────
.vscode/
*.code-workspace

# ── OS junk ───────────────────────────────────────
Thumbs.db
.DS_Store
desktop.ini

# ── Logs ──────────────────────────────────────────
*.log

# ── Secrets / tokens (if you ever add API keys) ──
.env
*.token